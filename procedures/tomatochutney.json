{
  "name": "tomatochutney",
  "steps": [
    {
      "id": "S1",
      "text": "Peel 4 large garlic cloves"
    },
    {
      "id": "S2",
      "text": "mince the garlic"
    },
    {
      "id": "S3",
      "text": "Take 1 tomato"
    },
    {
      "id": "S4",
      "text": "Chop tomato roughly (anysize chunks are fine)"
    },
    {
      "id": "S5",
      "text": "puree tomatoes without any water in a blender/mixer"
    },
    {
      "id": "S6",
      "text": "Heat 3 tbsp oil in a pan over medium heat"
    },
    {
      "id": "S7",
      "text": "Add 1/4 tsp mustard to the pan"
    },
    {
      "id": "S8",
      "text": "1/2 tsp cumin seeds to the pan"
    },
    {
      "id": "S9",
      "text": "When mustard and cumin seeds begin to sizzle, add minced garlic"
    },
    {
      "id": "S10",
      "text": "Lower the heat"
    },
    {
      "id": "S11",
      "text": "Saute the garlic for 2-3 minutes"
    },
    {
      "id": "S12",
      "text": "Add 2 tbsp red chili powder to the pan"
    },
    {
      "id": "S13",
      "text": "mix well contents of the pan"
    },
    {
      "id": "S14",
      "text": "Add tomato puree to the pan"
    },
    {
      "id": "S15",
      "text": "1/2 tsp salt to the pan"
    },
    {
      "id": "S16",
      "text": "Mix well tomato puree with contents in the pan"
    },
    {
      "id": "S17",
      "text": "Allow the mixture to simmer over low heat for 5 minutes or until the mixture becomes thick"
    },
    {
      "id": "S18",
      "text": "Take the pan off the heat"
    },
    {
      "id": "S19",
      "text": "Transfer it to a serving bowl"
    }
  ],
