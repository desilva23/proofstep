{
  "name": "zoodles",
  "steps": [
    {
      "id": "S1",
      "text": "Peel 1 garlic cloves"
    },
    {
      "id": "S2",
      "text": "Spiralize 1 medium zucchini into thin noodles using a spiralizer"
    },
    {
      "id": "S3",
      "text": "Heat a large pan on medium heat"
    },
    {
      "id": "S4",
      "text": "Melt 1 tablespoons of softened butter"
    },
    {
      "id": "S5",
      "text": "Add 1 large minced garlic cloves to the pan"
    },
    {
      "id": "S6",
      "text": "Cook garlic until fragrant (about 1 minutes). Be careful not to burn garlic"
    },
    {
      "id": "S7",
      "text": "1/6 cup grated parmesan cheese"
    },
    {
      "id": "S8",
      "text": "pepper to taste"
    },
    {
      "id": "S9",
      "text": "season with salt"
    },
    {
      "id": "S10",
      "text": "Add the zucchini noodles"
    },
    {
      "id": "S11",
      "text": "Cook for 2 minutes or until the zoodles are done"
    },
    {
      "id": "S12",
      "text": "Remove from heat"
    },
    {
      "id": "S13",
      "text": "Top with more parmesan if desired"
    }
  ],
