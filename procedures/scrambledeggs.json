{
  "name": "scrambledeggs",
  "steps": [
    {
      "id": "S1",
      "text": "Chop 1 tsp cilantro"
    },
    {
      "id": "S2",
      "text": "Chop 1 green chilli"
    },
    {
      "id": "S3",
      "text": "Chop 1/4 medium onion"
    },
    {
      "id": "S4",
      "text": "add 1/3 tsp salt to the bowl"
    },
    {
      "id": "S5",
      "text": "Crack one egg in the bowl"
    },
    {
      "id": "S6",
      "text": "Chop 1/4 tomato"
    },
    {
      "id": "S7",
      "text": "Peel 2 garlic cloves"
    },
    {
      "id": "S8",
      "text": "add 1 tbsp milk to the bowl"
    },
    {
      "id": "S9",
      "text": "Whisk the egg mixture in the bowl"
    },
    {
      "id": "S10",
      "text": "Mince peeled garlic cloves"
    },
    {
      "id": "S11",
      "text": "Heat 2 tbsp oil in a heavy-bottomed or nonstick pan on medium heat"
    },
    {
      "id": "S12",
      "text": "add 1/3 tsp salt to the pan"
    },
    {
      "id": "S13",
      "text": "add chopped onions to the pan"
    },
    {
      "id": "S14",
      "text": "Saute the onions on medium heat until they are soft and translucent"
    },
    {
      "id": "S15",
      "text": "Add garlic to the pan"
    },
    {
      "id": "S16",
      "text": "Add chilli to the pan"
    },
    {
      "id": "S17",
      "text": "Cook for 1 minute, mixing everything"
    },
    {
      "id": "S18",
      "text": "Add 1/8 tsp of turmeric to the pan"
    },
    {
      "id": "S19",
      "text": "Add tomatoes to the pan"
    },
    {
      "id": "S20",
      "text": "Cook covered for 1 minute or until the tomatoes soften"
    },
    {
      "id": "S21",
      "text": "Slowly pour the whisked eggs into the pan"
    },
    {
      "id": "S22",
      "text": "Keep mixing with a spatula for 3 minutes or until the eggs are almost cooked"
    },
    {
      "id": "S23",
      "text": "Garnish with 1 tbsp chopped cilantro and serve"
    }
  ],
