{
  "name": "buttercorncup",
  "steps": [
    {
      "id": "S1",
      "text": "Measure 2 cups of frozen corn"
    },
    {
      "id": "S2",
      "text": "Extract lime juice from 1/3 lime"
    },
    {
      "id": "S3",
      "text": "Thaw the frozen corn by putting it in a sieve and running it under cold water"
    },
    {
      "id": "S4",
      "text": "Add the corn into a microwave-safe bowl"
    },
    {
      "id": "S5",
      "text": "Microwave the corn for 2 minutes"
    },
    {
      "id": "S6",
      "text": "1 teaspoon of pepper powder to the bowl"
    },
    {
      "id": "S7",
      "text": "Add 1 teaspoon of softened butter"
    },
    {
      "id": "S8",
      "text": "then stir the bowl"
    },
    {
      "id": "S9",
      "text": "Microwave the corn for 3 more minutes"
    },
    {
      "id": "S10",
      "text": "add lime juice to the bowl"
    },
    {
      "id": "S11",
      "text": "Add 1 teaspoon salt to the bowl"
    },
    {
      "id": "S12",
      "text": "Mix the contents of the bowl well"
    }
  ],
