# Copy to .env and fill in. .env is git-ignored.
# An exported shell variable with the same name wins over this file.
MODEL_API_KEY=

# Optional. Contributor models are much cheaper, but Meta may train on what you send:
# fine for the public CaptainCook4D videos, not for private footage.
# PROOFSTEP_SPARK_MODEL=muse-spark-1.3-contributor

# Optional, for --open-weights: Muse Spark Open on Baseten, or any OpenAI-compatible server,
# including your own hardware.
# BASETEN_API_KEY=
# PROOFSTEP_OPEN_URL=https://inference.baseten.co/v1/chat/completions
# PROOFSTEP_OPEN_MODEL=meta-models/muse-spark-open
